{
  "public": ".",
  "rewrites": [
    { "source": "/", "destination": "/webr2/index.html" },
    { "source": "/webr2", "destination": "/webr2/index.html" },
    { "source": "/webr2/", "destination": "/webr2/index.html" },
    { "source": "/webr2.html", "destination": "/webr2/index.html" }
  ],
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ]
}
